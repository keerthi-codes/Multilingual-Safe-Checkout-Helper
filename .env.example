# Application Settings
PROJECT_NAME="Multilingual Safe-Checkout Helper"
ENVIRONMENT="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# AI Assistant Configuration
# Options for AI_PROVIDER: 'mock' (default, offline & deterministic) or 'gemini' (live API)
AI_PROVIDER=mock

# Gemini API Configuration (Required only when AI_PROVIDER=gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# PayPal Configuration
# Options for PAYPAL_MODE: 'mock' (default, offline & deterministic) or 'sandbox'
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_SANDBOX_BASE_URL="https://api-m.sandbox.paypal.com"
# Configurable demo conversion rate for Sandbox USD checkout (Catalogue/Mandates stay strictly in INR)
PAYPAL_DEMO_EXCHANGE_RATE_INR_TO_USD=0.012
